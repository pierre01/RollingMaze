<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="RollingMaze.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#101713">

    <Grid>
        <skia:SKCanvasView x:Name="GameCanvas"
                           PaintSurface="OnPaintSurface"
                           EnableTouchEvents="True"
                           Touch="OnCanvasTouch" />

        <Grid Padding="18" InputTransparent="True">
            <Grid RowDefinitions="Auto,*">
                <Border StrokeThickness="0"
                        BackgroundColor="#B91B2620"
                        StrokeShape="RoundRectangle 18"
                        Padding="14,9"
                        HorizontalOptions="Start">
                    <HorizontalStackLayout Spacing="10">
                        <Label x:Name="MaterialDot" Text="●" FontSize="18" VerticalTextAlignment="Center" />
                        <Label x:Name="StatusLabel" Text="Choose a ball" TextColor="White" FontSize="15" VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>
                </Border>
                <Label Grid.Row="1"
                       Text="KNOCK BEHIND DEVICE TO BOUNCE"
                       TextColor="#8FD1A4"
                       FontSize="11"
                       FontAttributes="Bold"
                       CharacterSpacing="2"
                       HorizontalOptions="Center"
                       VerticalOptions="End"
                       Margin="0,0,0,12" />
            </Grid>
        </Grid>

        <Grid x:Name="SelectionOverlay" BackgroundColor="#E90A100D" Padding="28">
            <VerticalStackLayout VerticalOptions="Center" Spacing="18" MaximumWidthRequest="560">
                <Label Text="ROLLING MAZE" TextColor="#F3E8C9" FontSize="34" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                <Label Text="Choose your ball" TextColor="#AAB9AE" FontSize="18" HorizontalTextAlignment="Center" />

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" Margin="0,12,0,0">
                    <Button Grid.Column="0" Text="🟤&#10;WOOD" StyleClass="BallChoice" Clicked="OnWoodClicked" />
                    <Button Grid.Column="1" Text="⚪&#10;SILVER" StyleClass="BallChoice" Clicked="OnSilverClicked" />
                    <Button Grid.Column="2" Text="🟡&#10;GOLD" StyleClass="BallChoice" Clicked="OnGoldClicked" />
                </Grid>

                <Label Text="WOOD  •  light &amp; grippy     SILVER  •  balanced     GOLD  •  heavy &amp; slick"
                       TextColor="#819087" FontSize="11" HorizontalTextAlignment="Center" />
                <Label Text="Tilt to roll and knock behind the device to bounce. On desktop, drag anywhere to tilt."
                       TextColor="#C3CEC7" FontSize="13" HorizontalTextAlignment="Center" Margin="0,8,0,0" />
            </VerticalStackLayout>
        </Grid>

        <Grid x:Name="WinOverlay" IsVisible="False" BackgroundColor="#D90A100D" Padding="28">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="16" MaximumWidthRequest="400">
                <Label x:Name="ResultTitleLabel" Text="GOAL!" TextColor="#F2CF55" FontSize="52" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                <Label x:Name="WinDetailLabel" Text="You made it." TextColor="White" FontSize="18" HorizontalTextAlignment="Center" />
                <Button x:Name="ContinueButton" Text="PLAY AGAIN" Clicked="OnPlayAgainClicked" BackgroundColor="#D8B949" TextColor="#101713" CornerRadius="18" Padding="28,14" />
                <Button Text="CHANGE BALL" Clicked="OnChangeBallClicked" BackgroundColor="Transparent" BorderColor="#819087" BorderWidth="1" TextColor="#DDE6E0" CornerRadius="18" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
