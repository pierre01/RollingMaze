<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="RollingMaze.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#101713">

    <Grid>
        <Grid RowDefinitions="Auto,*,Auto">
            <VerticalStackLayout Grid.Row="0" Padding="16,8" Spacing="6"
                                 BackgroundColor="#1B2620" InputTransparent="True">
                <HorizontalStackLayout Spacing="10">
                    <Label x:Name="MaterialDot" Text="●" FontSize="18" VerticalTextAlignment="Center" />
                    <Label x:Name="StatusLabel" Text="Choose a ball" TextColor="White" FontSize="15" VerticalTextAlignment="Center" />
                </HorizontalStackLayout>
                <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="SpaceBetween" AlignItems="Center">
                    <Label x:Name="TimerLabel" Text="TIME 120" TextColor="#F3E8C9" FontSize="14" FontAttributes="Bold" Margin="0,2,12,2" />
                    <Label x:Name="LivesLabel" Text="LIVES ♥♥♥" TextColor="#E76D5B" FontSize="14" FontAttributes="Bold" Margin="0,2,12,2" />
                    <Label x:Name="ScoreLabel" Text="SCORE 0" TextColor="#8FD1A4" FontSize="14" FontAttributes="Bold" Margin="0,2,12,2" />
                    <Label x:Name="BestScoreLabel" Text="BEST 0" TextColor="#F2CF55" FontSize="14" FontAttributes="Bold" Margin="0,2,0,2" />
                </FlexLayout>
            </VerticalStackLayout>

            <AbsoluteLayout Grid.Row="1">
                <skia:SKCanvasView x:Name="GameCanvas"
                               AbsoluteLayout.LayoutBounds="0,0,1,1"
                               AbsoluteLayout.LayoutFlags="All"
                               PaintSurface="OnPaintSurface"
                               EnableTouchEvents="True"
                               Touch="OnCanvasTouch" />
                <Image x:Name="GoalFlag" Source="flag_checkered.png"
                       Aspect="AspectFit" InputTransparent="True" IsVisible="False"
                       SemanticProperties.Description="Goal" />
            </AbsoluteLayout>

            <VerticalStackLayout x:Name="FooterPanel" Grid.Row="2" Padding="12,6" Spacing="4">
                <Label Text="KNOCK BEHIND DEVICE TO BOUNCE"
                       TextColor="#8FD1A4"
                       FontSize="11"
                       FontAttributes="Bold"
                       CharacterSpacing="1"
                       HorizontalTextAlignment="Center"
                       InputTransparent="True" />
            </VerticalStackLayout>
        </Grid>

        <Grid x:Name="SelectionOverlay" BackgroundColor="#E90A100D" Padding="28">
            <VerticalStackLayout VerticalOptions="Center" Spacing="18" MaximumWidthRequest="560">
                <Label Text="ROLLING MAZE" TextColor="#F3E8C9" FontSize="34" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                <Label Text="Choose your ball" TextColor="#AAB9AE" FontSize="18" HorizontalTextAlignment="Center" />

                <Grid x:Name="BallChoices" ColumnDefinitions="*,*,*" ColumnSpacing="10" Margin="0,12,0,0">
                    <Button Grid.Column="0" Text="🟤&#10;WOOD" StyleClass="BallChoice" Clicked="OnWoodClicked" />
                    <Button Grid.Column="1" Text="⚪&#10;SILVER" StyleClass="BallChoice" Clicked="OnSilverClicked" />
                    <Button Grid.Column="2" Text="🟡&#10;GOLD" StyleClass="BallChoice" Clicked="OnGoldClicked" />
                </Grid>

                <Label Text="WOOD  •  light &amp; grippy     SILVER  •  balanced     GOLD  •  heavy &amp; slick"
                       TextColor="#819087" FontSize="11" HorizontalTextAlignment="Center" />
                <Label Text="Tilt to roll and knock behind the device to bounce. On desktop, drag anywhere to tilt."
                       TextColor="#C3CEC7" FontSize="13" HorizontalTextAlignment="Center" Margin="0,8,0,0" />
                <Button x:Name="CalibrateTiltButton" Text="Calibrate tilt" Clicked="OnCalibrateTiltClicked"
                        BackgroundColor="#D8B949" TextColor="#101713" CornerRadius="18" />
                <Label x:Name="CalibrationStatusLabel" Text="Lay the phone flat, then calibrate. Keep it still until finished."
                       TextColor="#C3CEC7" FontSize="13" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>

        <Grid x:Name="WinOverlay" IsVisible="False" BackgroundColor="#D90A100D" Padding="28">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="16" MaximumWidthRequest="400">
                <Label x:Name="ResultTitleLabel" Text="GOAL!" TextColor="#F2CF55" FontSize="52" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                <Label x:Name="WinDetailLabel" Text="You made it." TextColor="White" FontSize="18" HorizontalTextAlignment="Center" />
                <Button x:Name="ContinueButton" Text="PLAY AGAIN" Clicked="OnPlayAgainClicked" BackgroundColor="#D8B949" TextColor="#101713" CornerRadius="18" Padding="28,14" />
                <Button x:Name="ChangeBallButton" Text="CHANGE BALL" Clicked="OnChangeBallClicked" BackgroundColor="Transparent" BorderColor="#819087" BorderWidth="1" TextColor="#DDE6E0" CornerRadius="18" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
