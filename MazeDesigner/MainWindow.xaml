<Window x:Class="MazeDesigner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rolling Maze Designer" Width="1100" Height="760" MinWidth="760" MinHeight="540"
        Background="#17251D">
  <DockPanel Margin="16">
    <Border DockPanel.Dock="Top" Background="#24382D" CornerRadius="10" Padding="10" Margin="0,0,0,12">
      <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <Button Content="New" Click="New_Click" Margin="4" Padding="14,7" />
          <Button Content="Open…" Click="Open_Click" Margin="4" Padding="14,7" />
          <Button Content="Save" Click="Save_Click" Margin="4" Padding="14,7" />
          <Button Content="Save As…" Click="SaveAs_Click" Margin="4" Padding="14,7" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Maze name" Foreground="#D9E7DE" VerticalAlignment="Center" Margin="4,0,8,0" />
          <TextBox x:Name="NameBox" Width="260" Text="Untitled maze" TextChanged="NameBox_TextChanged" Padding="7" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Left" Width="190" Background="#24382D" CornerRadius="10" Padding="12" Margin="0,0,12,0">
      <StackPanel>
        <TextBlock Text="TOOLS" Foreground="#F2CF55" FontWeight="Bold" Margin="4,4,4,10" />
        <RadioButton GroupName="Tools" Content="Select / move" Tag="Select" IsChecked="True" Checked="Tool_Checked" Margin="4,6" Foreground="#FFFCFCFC" />
        <RadioButton GroupName="Tools" Content="Draw wall" Tag="Wall" Checked="Tool_Checked" Margin="4,6" Foreground="White" />
        <RadioButton GroupName="Tools" Content="Place start" Tag="Start" Checked="Tool_Checked" Margin="4,6" Foreground="White" />
        <RadioButton GroupName="Tools" Content="Place goal" Tag="Goal" Checked="Tool_Checked" Margin="4,6" Foreground="White" />
        <RadioButton GroupName="Tools" Content="Place hole" Tag="Hole" Checked="Tool_Checked" Margin="4,6" Foreground="White" />
        <RadioButton GroupName="Tools" Content="Place dip" Tag="Dip" Checked="Tool_Checked" Margin="4,6" Foreground="White" />
        <Separator Margin="0,12" />
        <Button Content="Delete selected" Click="Delete_Click" Padding="8" />
        <TextBlock Text="Draw walls by dragging. In Select mode, drag a wall or marker. Hold Shift while drawing to snap horizontally or vertically."
                   TextWrapping="Wrap" Foreground="#AFC2B6" Margin="4,16,4,0" LineHeight="18" />
      </StackPanel>
    </Border>

    <Grid>
      <Border Background="#263F30" BorderBrush="#A07E49" BorderThickness="8" CornerRadius="18" ClipToBounds="True">
        <Canvas x:Name="Board" Background="#264A34" MouseLeftButtonDown="Board_MouseLeftButtonDown"
                MouseMove="Board_MouseMove" MouseLeftButtonUp="Board_MouseLeftButtonUp" SizeChanged="Board_SizeChanged" />
      </Border>
      <TextBlock x:Name="StatusText" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="10"
                 Background="#CC17251D" Foreground="White" Padding="12,6" Text="Ready" />
    </Grid>
  </DockPanel>
</Window>
